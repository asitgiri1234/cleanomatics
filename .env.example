# Groq — paste your key here (get one at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
LLM_MAX_TOKENS=1024

# Knowledge base
KB_DIR=knowledge_base

# Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=4
SIMILARITY_THRESHOLD=0.30
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP_CHARS=150

# API
APP_HOST=127.0.0.1
APP_PORT=8000
